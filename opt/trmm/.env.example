# ==============================================================================
# /opt/trmm/.env - Tactical RMM Konfiguration
# ==============================================================================
# install.sh erzeugt diese Datei automatisch mit zufaelligen Passwoertern
# (Rechte 600). Sie wird bei Updates NIE ueberschrieben, nur um fehlende
# Schluessel ergaenzt.
# ==============================================================================

# Compose-Projektname - bestimmt die Namen der Docker-Volumes.
# Bei Migration einer alten Installation (z.B. ~/tactical-rmm) setzt
# install.sh hier den alten Projektnamen, damit die Daten-Volumes bleiben.
COMPOSE_PROJECT_NAME=trmm

# TRMM-Images: VERSION auf ein Release pinnen (z.B. 1.5.2) statt "latest".
# Update: trmmctl update [version]
IMAGE_REPO=tacticalrmm/
VERSION=latest

# Datenbank-Images (Major-Version). Ein Wechsel erzeugt ein neues Volume -
# Daten danach mit "trmmctl migrate-db" uebernehmen.
POSTGRES_VERSION=18
REDIS_VERSION=8
# MongoDB >= 5.0 braucht eine CPU mit AVX (Proxmox: CPU-Typ host/x86-64-v3)
MONGO_VERSION=8.0
# WiredTiger-Cache in GB (Default von MongoDB waere ~50% des RAMs)
MONGO_CACHE_GB=0.25

# tactical credentials (Used to login to dashboard)
TRMM_USER=admin
TRMM_PASS=changeme

# optional web port override settings
TRMM_HTTP_PORT=80
TRMM_HTTPS_PORT=443

# dns settings
APP_HOST=rmm.example.com
API_HOST=api.example.com
MESH_HOST=mesh.example.com

# cookie domain override - optional, must encompass all 3 domains
# CSRF_COOKIE_DOMAIN=example.com
# SESSION_COOKIE_DOMAIN=example.com

# mesh settings
MESH_USER=meshadmin
MESH_PASS=changeme
MONGODB_USER=mongouser
MONGODB_PASSWORD=changeme
MESH_PERSISTENT_CONFIG=0

# database settings
POSTGRES_USER=trmm
POSTGRES_PASS=changeme

# disable web terminal
TRMM_DISABLE_WEB_TERMINAL=False

# disable server side scripts
TRMM_DISABLE_SERVER_SCRIPTS=False

# disable sso
TRMM_DISABLE_SSO=False

# Zertifikat (Base64 von fullchain.pem / privkey.pem).
# Leer = selbstsigniertes Zertifikat. Setzen mit: trmmctl cert [domain]
CERT_PUB_KEY=
CERT_PRIV_KEY=
