#!/bin/bash
# ==============================================================================
# server-update
# Installiert unkritische Updates automatisch, kritische manuell
# ==============================================================================
# Autor:    Phydran6
# Version:  2026-10-25
# System:   Debian/Ubuntu
# Pfad:     /usr/local/sbin/server-update
# ==============================================================================
# Logik:
#   - NIEDRIG Pakete werden automatisch installiert
#   - KRITISCH/MITTEL Pakete werden angezeigt mit Installationsbefehl
#   - Docker-Engine zaehlt als kritisch (Update startet alle Container neu)
# ==============================================================================

# kritische pakete pattern (werden NICHT automatisch installiert)
KRITISCH_PATTERN="^(linux-image|linux-headers|openssl|libssl|libcrypto|grub|initramfs|efi|sudo|openssh|libpam-|systemd|libudev|libsystemd|libc6|libgcc|bash|coreutils|util-linux|docker|containerd|runc)"

# unbeaufsichtigt: keine dialoge, geaenderte config-dateien behalten
export DEBIAN_FRONTEND=noninteractive
APT_OPTS=(-y -o Dpkg::Options::=--force-confdef -o Dpkg::Options::=--force-confold)

if [ "$EUID" -ne 0 ]; then
    echo "FEHLER: root-rechte benoetigt (sudo server-update)"
    exit 1
fi

# paketlisten aktualisieren
echo "=> paketlisten aktualisieren..."
apt-get update -qq 2>/dev/null || exit 1

# updates holen
UPDATES=$(apt list --upgradable 2>/dev/null | grep "/" | sort)
[ -z "$UPDATES" ] && { echo "OK - keine updates"; exit 0; }

# kategorisieren
declare -a AUTO=() MANUELL=()
while IFS= read -r line; do
    [ -z "$line" ] && continue
    pkg=$(echo "$line" | cut -d'/' -f1)
    if echo "$pkg" | grep -qiE "$KRITISCH_PATTERN"; then
        MANUELL+=("$pkg")
    else
        AUTO+=("$pkg")
    fi
done <<< "$UPDATES"

# automatisch installieren
if [ ${#AUTO[@]} -gt 0 ]; then
    echo "=> installiere ${#AUTO[@]} unkritische(s) paket(e)..."
    for pkg in "${AUTO[@]}"; do
        echo "   $pkg"
    done
    # apt install markiert pakete als "manuell" - auto-markierung danach wiederherstellen,
    # sonst raeumt autoremove alte abhaengigkeiten nie mehr auf
    AUTO_MARKIERT=$(apt-mark showauto 2>/dev/null)
    apt-get install --only-upgrade "${APT_OPTS[@]}" "${AUTO[@]}" 2>&1 | grep -E "^(Inst|Conf|Setting up)" || true
    printf '%s\n' "${AUTO[@]}" | grep -Fxf <(echo "$AUTO_MARKIERT") | xargs -r apt-mark auto >/dev/null
fi

# kritische anzeigen
if [ ${#MANUELL[@]} -gt 0 ]; then
    echo ""
    echo "========================================"
    echo "KRITISCHE UPDATES - MANUELLE INSTALLATION"
    echo "========================================"
    echo ""
    echo "Folgende ${#MANUELL[@]} Paket(e) wurden NICHT installiert"
    echo "(Kernel/Boot/Systemd/Core/Docker - Reboot oder Risiko):"
    echo ""
    for pkg in "${MANUELL[@]}"; do
        echo "  $pkg"
        echo "    -> sudo apt install --only-upgrade $pkg"
        echo ""
    done
    echo "Alle kritischen auf einmal:"
    echo "  -> sudo apt install --only-upgrade ${MANUELL[*]}"
fi

# cache aufraeumen
echo ""
echo "=> cache aufraeumen..."
apt-get autoclean -qq 2>/dev/null

# zusammenfassung
echo ""
echo "========================================"
echo "ZUSAMMENFASSUNG"
echo "========================================"
echo "Installiert:     ${#AUTO[@]} paket(e)"
echo "Uebersprungen:   ${#MANUELL[@]} paket(e) (kritisch)"
[ -f /var/run/reboot-required ] && echo "*** NEUSTART ERFORDERLICH ***"
exit 0
